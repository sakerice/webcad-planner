    { "id": "field-type-north-object", "patch": { "collections": {}, "fields": { "northDeg": {} } } },
    { "id": "field-type-north-huge", "patch": { "collections": {}, "fields": { "northDeg": 1e300 } } },
    { "id": "field-type-autolights-string", "patch": { "collections": {}, "fields": { "autoRoomLights": "off" } } },
    { "id": "field-type-floors-string", "patch": { "collections": {}, "fields": { "floors": "1" } } },
    { "id": "nested-proto-in-upsert", "patch": { "collections": { "items": { "upserts": [{ "id": 1, "finishColors": { "__proto__": { "polluted": "nested" } } }], "removes": [] } } } },
    { "id": "nested-constructor-in-upsert", "patch": { "collections": { "items": { "upserts": [{ "id": 1, "constructor": { "prototype": { "polluted": "nested" } } }], "removes": [] } } } },
    { "id": "nested-prototype-in-field", "patch": { "collections": {}, "fields": { "exteriorWallSettings": { "walls": { "1": { "prototype": { "polluted": 1 } } } } } } },
    { "id": "nested-proto-in-array", "patch": { "collections": { "rooms": { "upserts": [{ "id": "rm1", "pts": [{ "__proto__": { "polluted": "arr" } }] }], "removes": [] } } } },
    { "id": "coord-string", "patch": { "collections": { "walls": { "upserts": [{ "id": 1, "x1": "abc", "y1": 0, "x2": 1000, "y2": 0 }], "removes": [] } } } },
    { "id": "coord-huge", "patch": { "collections": { "items": { "upserts": [{ "id": 1, "type": "bed", "x": 1e300, "y": 0, "w": 900, "d": 2000 }], "removes": [] } } } },
    { "id": "coord-object", "patch": { "collections": { "rooms": { "upserts": [{ "id": "rm1", "x": {}, "y": 0, "w": 900, "d": 900 }], "removes": [] } } } },
    { "id": "coord-bool", "patch": { "collections": { "items": { "upserts": [{ "id": 1, "type": "bed", "x": 0, "y": true, "w": 900, "d": 2000 }], "removes": [] } } } }
  ]
}
