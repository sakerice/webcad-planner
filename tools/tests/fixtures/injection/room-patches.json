{
  "about": "共同編集のルームの /update に送る、形の壊れた差分(patch)の固定集。tools/tests/room-patch-guard.test.cjs が使う。どれも 400 で断られ、ルームの状態が変わらないこと。__proto__ は JSON.parse で自分の鍵として作られる(この JSON をそのまま送る)。深さ・件数・長さの上限を超える物は、大きいのでテストの中で作る。",
  "bad": [
    { "id": "patch-string", "patch": "abc" },
    { "id": "patch-array", "patch": [] },
    { "id": "patch-number", "patch": 5 },
    { "id": "unknown-top-key", "patch": { "collections": {}, "fields": {}, "extra": 1 } },
    { "id": "top-proto", "patch": { "collections": {}, "__proto__": { "polluted": "top" } } },
    { "id": "collections-string", "patch": { "collections": "abc" } },
    { "id": "collections-array", "patch": { "collections": [] } },
    { "id": "collections-null", "patch": { "collections": null } },
    { "id": "unknown-collection", "patch": { "collections": { "doors": { "upserts": [], "removes": [] } } } },
    { "id": "collection-proto", "patch": { "collections": { "__proto__": { "upserts": [{ "id": 1 }] } } } },
    { "id": "collection-constructor", "patch": { "collections": { "constructor": { "upserts": [], "removes": [] } } } },
    { "id": "collection-toString", "patch": { "collections": { "toString": { "upserts": [], "removes": [] } } } },
    { "id": "change-string", "patch": { "collections": { "walls": "x" } } },
    { "id": "change-array", "patch": { "collections": { "walls": [] } } },
    { "id": "change-unknown-key", "patch": { "collections": { "walls": { "upserts": [], "removes": [], "extra": [] } } } },
    { "id": "upserts-string", "patch": { "collections": { "walls": { "upserts": "abc", "removes": [] } } } },
    { "id": "upserts-object", "patch": { "collections": { "items": { "upserts": { "id": 1 }, "removes": [] } } } },
    { "id": "upsert-null", "patch": { "collections": { "items": { "upserts": [null], "removes": [] } } } },
    { "id": "upsert-string", "patch": { "collections": { "items": { "upserts": ["abc"], "removes": [] } } } },
    { "id": "upsert-array", "patch": { "collections": { "items": { "upserts": [[1, 2]], "removes": [] } } } },
    { "id": "upsert-no-id", "patch": { "collections": { "items": { "upserts": [{ "x": 1 }], "removes": [] } } } },
    { "id": "upsert-id-null", "patch": { "collections": { "items": { "upserts": [{ "id": null }], "removes": [] } } } },
    { "id": "upsert-id-object", "patch": { "collections": { "items": { "upserts": [{ "id": { "a": 1 } }], "removes": [] } } } },
    { "id": "upsert-id-bool", "patch": { "collections": { "rooms": { "upserts": [{ "id": true }], "removes": [] } } } },
    { "id": "upsert-id-array", "patch": { "collections": { "rooms": { "upserts": [{ "id": ["rm1"] }], "removes": [] } } } },
    { "id": "removes-string", "patch": { "collections": { "walls": { "upserts": [], "removes": "abc" } } } },
    { "id": "removes-object", "patch": { "collections": { "walls": { "upserts": [], "removes": { "0": "1" } } } } },
    { "id": "remove-null", "patch": { "collections": { "walls": { "upserts": [], "removes": [null] } } } },
    { "id": "remove-object", "patch": { "collections": { "walls": { "upserts": [], "removes": [{}] } } } },
    { "id": "remove-bool", "patch": { "collections": { "walls": { "upserts": [], "removes": [false] } } } },
    { "id": "fields-string", "patch": { "collections": {}, "fields": "x" } },
    { "id": "fields-array", "patch": { "collections": {}, "fields": [] } },
    { "id": "fields-unknown", "patch": { "collections": {}, "fields": { "planName": "x" } } },
    { "id": "fields-walls", "patch": { "collections": {}, "fields": { "walls": [] } } },
    { "id": "fields-viewState", "patch": { "collections": {}, "fields": { "viewState": { "z": 2 } } } },
    { "id": "fields-proto", "patch": { "collections": {}, "fields": { "__proto__": { "polluted": "fields" } } } },
    { "id": "fields-constructor", "patch": { "collections": {}, "fields": { "constructor": { "prototype": { "polluted": "ctor" } } } } },
    { "id": "fields-prototype", "patch": { "collections": {}, "fields": { "prototype": { "polluted": "proto" } } } },
    { "id": "fields-hasOwnProperty", "patch": { "collections": {}, "fields": { "hasOwnProperty": 1 } } },
    { "id": "field-type-settings-string", "patch": { "collections": {}, "fields": { "exteriorWallSettings": "abc" } } },
